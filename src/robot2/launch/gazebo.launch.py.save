"""
Mirrors go2_config's gazebo.launch.py structure exactly (confirmed
working pattern) - just renamed go2 -> my_robot. Once your URDF/xacro
and config yamls are ready, this should work as-is aside from the
world_init_z tuning noted below.
"""

import os

import subprocess

import launch_ros
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, SetEnvironmentVariable

# TODO change this to match actual name
name = "robot2"
def generate_launch_description():

    use_sim_time = LaunchConfiguration("use_sim_time")

    # Single merged package - config and description both live here,
    # so there's only one share directory to look up.
    config_pkg_share = launch_ros.substitutions.FindPackageShare(
        package=name
    ).find(name)

        # Gazebo Classic finds package:// meshes via GAZEBO_MODEL_PATH, not ROS's
    # package index, so put the mesh package's install "share" dir on that path.
    mesh_share_parent = os.path.dirname(
        get_package_share_directory("yobotics_description")
    )
    existing_model_path = os.environ.get("GAZEBO_MODEL_PATH", "")
    set_gazebo_model_path = SetEnvironmentVariable(
        name="GAZEBO_MODEL_PATH",
        value=mesh_share_parent
        + (os.pathsep + existing_model_path if existing_model_path else ""),
    )

    joints_config = os.path.join(config_pkg_share, "config/joints/joints.yaml")
    ros_control_config = os.path.join(
        config_pkg_share, "config/ros_control/ros_control.yaml"
    )
    gait_config = os.path.join(config_pkg_share, "config/gait/gait.yaml")
    links_config = os.path.join(config_pkg_share, "config/links/links.yaml")

    # TODO: point at your team's real xacro/urdf file once you have it
    pathName = "xacro/" + name + ".xacro"
    
    xacro_path = os.path.join(config_pkg_share, "xacro", "robot2.xacro")

    clean_urdf_path = "/tmp/robot2_no_comments.urdf"

    subprocess.run(
        [
        "python3",
        os.path.join(
            os.path.expanduser("~/champ_ws/src/robot2"),
            "scripts",
            "clean_xacro.py"
        ),
        xacro_path
    ],
    stdout=open(clean_urdf_path, "w"),
    check=True
)

default_model_path = clean_urdf_path
    default_world_path = os.path.join(config_pkg_share, "worlds/default.world")

    declare_use_sim_time = DeclareLaunchArgument(
        "use_sim_time",
        default_value="true",
        description="Use simulation (Gazebo) clock if true",
    )
    declare_rviz = DeclareLaunchArgument(
        "rviz", default_value="false", description="Launch rviz"
    )
    declare_robot_name = DeclareLaunchArgument(
        "robot_name", default_value="my_robot", description="Robot name"
    )
    declare_lite = DeclareLaunchArgument(
        "lite", default_value="false", description="Lite"
    )
    declare_ros_control_file = DeclareLaunchArgument(
        "ros_control_file",
        default_value=ros_control_config,
        description="Ros control config path",
    )
    declare_gazebo_world = DeclareLaunchArgument(
        "world", default_value=default_world_path, description="Gazebo world name"
    )
    declare_gui = DeclareLaunchArgument(
        "gui", default_value="true", description="Use gui"
    )
    declare_world_init_x = DeclareLaunchArgument("world_init_x", default_value="0.0")
    declare_world_init_y = DeclareLaunchArgument("world_init_y", default_value="0.0")
    # TODO: set to your robot's standing hip height (matches nominal_height
    # in gait.yaml, roughly) so it doesn't spawn clipped into/floating
    # above the ground plane.
    declare_world_init_z = DeclareLaunchArgument("world_init_z", default_value="0.45")
    declare_world_init_heading = DeclareLaunchArgument(
        "world_init_heading", default_value="0.0"
    )

    bringup_ld = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                get_package_share_directory("champ_bringup"),
                "launch",
                "bringup.launch.py",
            )
        ),
        launch_arguments={
            "description_path": default_model_path,
            "joints_map_path": joints_config,
            "links_map_path": links_config,
            "gait_config_path": gait_config,
            "use_sim_time": LaunchConfiguration("use_sim_time"),
            "robot_name": LaunchConfiguration("robot_name"),
            "gazebo": "true",
            "lite": LaunchConfiguration("lite"),
            "rviz": LaunchConfiguration("rviz"),
            # TODO: this topic name depends on the controller defined in
            # ros_control.yaml - update if yours differs.
            "joint_controller_topic": "joint_group_effort_controller/joint_trajectory",
            "hardware_connected": "false",
            "publish_foot_contacts": "false",
            "close_loop_odom": "true",
        }.items(),
    )

    gazebo_ld = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                get_package_share_directory("champ_gazebo"),
                "launch",
                "gazebo.launch.py",
            )
        ),
        launch_arguments={
            "use_sim_time": LaunchConfiguration("use_sim_time"),
            "robot_name": LaunchConfiguration("robot_name"),
            "world": LaunchConfiguration("world"),
            "lite": LaunchConfiguration("lite"),
            "world_init_x": LaunchConfiguration("world_init_x"),
            "world_init_y": LaunchConfiguration("world_init_y"),
            "world_init_z": LaunchConfiguration("world_init_z"),
            "world_init_heading": LaunchConfiguration("world_init_heading"),
            "gui": LaunchConfiguration("gui"),
            "close_loop_odom": "true",
        }.items(),
    )

    return LaunchDescription(
        [
            declare_use_sim_time,
            declare_rviz,
            declare_robot_name,
            declare_lite,
            declare_ros_control_file,
            declare_gazebo_world,
            declare_gui,
            declare_world_init_x,
            declare_world_init_y,
            declare_world_init_z,
            declare_world_init_heading,
            set_gazebo_model_path,
            declare_use_sim_time,
            bringup_ld,
            gazebo_ld,
        ]
    )
